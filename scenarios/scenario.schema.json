{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Stalley Mod scenario",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "formatVersion",
    "id",
    "name",
    "fixture"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "formatVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "saveFile"
      ],
      "properties": {
        "saveFile": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,119}$",
          "not": {
            "const": "SaveGameInfo"
          }
        }
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "surroundingsSize": {
          "type": "integer",
          "minimum": -1,
          "default": -1
        }
      }
    },
    "expectedStart": {
      "type": "object",
      "additionalProperties": true
    }
  }
}
